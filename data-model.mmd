erDiagram
    %% Core data model in Supabase Postgres (+ pgvector)
    %% Field names and market values follow All-context/05-web-sources/fetching-sources.md section 7
    %% Chain: SOURCE -> FINDING -> CASE (problem) -> REQUIREMENT (solution) -> DECISION, all logged in AUDIT_EVENT

    CONFIG {
        uuid id PK
        text vehicle "e.g. G60"
        text market "USA, China, Europe, Rest of World"
        jsonb competitor_set
        jsonb brand_profile "versioned assumption"
        jsonb source_filter
    }
    WEIGHT_PROFILE {
        uuid id PK
        uuid config_id FK
        text name "e.g. focus speed, focus budget"
        jsonb case_weights "factor -> weight"
        jsonb cost_adjustment "S, M, L -> multiplier"
        text created_by
    }
    VEHICLE {
        text code PK "G60"
        text series "5 Series"
        text segment "entry, business, luxury"
        text generation
        text predecessor_code
        text_array markets_sold
    }
    SALES_VOLUME {
        text vehicle FK
        text market
        int year "2024, 2025, 2030"
        int units
        bool suspect "e.g. RoW placeholder"
    }
    STUDY_SCORE {
        uuid id PK
        text vehicle FK
        text market
        text attribute
        text method "mean_10pt, dist_7level"
        jsonb raw
        float normalized "0..1"
        float dissatisfied_share "US only"
        uuid feature_id FK
    }
    FEATURE {
        uuid id PK
        text name "canonical, e.g. Seat ventilation"
        text car_area "Exterior, Interior, Powertrain, ..."
        text_array vfc_topics
        text_array option_codes
        text_array study_attributes
        text status "confirmed, candidate"
    }
    VEHICLE_FEATURE {
        text vehicle FK
        uuid feature_id FK
        text variant "e.g. i5 eDrive40"
        text market "DE for option lists"
        text availability "standard, optional, absent, removed"
        text sa_code
        numeric price_eur
        text record_id FK "PDF + page"
    }
    SOURCE {
        text record_id PK "source_id + own ID, see fetching-sources.md 7.2"
        text source_id "site, e.g. reddit, or bmw_feedback, option_list"
        text category "A..J from fetching-sources.md"
        text content_type "owner, expert, press, news"
        text level "model, brand"
        text url "or file + row / page"
        text raw_ref "untouched raw response"
        text content_hash
        timestamptz fetched_at
        timestamptz published_at
        text search_term
        text thread_id
        text author_hash
        text chassis_code
        text model_year
        text vehicle_role "current, predecessor, competitor, unknown"
        text powertrain "ICE, PHEV, BEV, unknown"
        text country "ISO code"
        text market "USA, China, Europe, Rest of World, unknown"
        text language
        text text_original
        text text_en
        jsonb engagement "upvotes, likes, views, replies"
    }
    DATA_RECORD {
        text record_id PK "fetching-sources.md 7.3"
        text source_id
        text chassis_code
        text powertrain
        text market
        text period "2026-09, 2025, 2030 forecast"
        text metric "e.g. range, registrations"
        numeric value
        text unit
        text source_location "sheet + cell, table, PDF page"
        text raw_ref
    }
    AGENT_RUN {
        uuid id PK
        text agent
        timestamptz started_at
        timestamptz ended_at
        int findings_valid
        int findings_rejected
        numeric llm_cost
        text status
    }
    FINDING {
        uuid id PK
        text record_id FK
        uuid run_id FK
        text schema_version
        text prompt_version
        text customer_ref "BMW verbatim ID or author_hash"
        text market "USA, China, Europe, Rest of World, unknown"
        text market_basis "stated, inferred, unknown"
        text vehicle
        text vehicle_role "current, predecessor, competitor, unknown"
        text powertrain
        text kind "complaint, wish, like, competitor_fact, trend, innovation"
        text severity "defect, difficult_to_use, wish, none"
        text_array car_area
        text feature_hint
        text summary "max 20 words EN"
        text quote "exact excerpt of text_original"
        text quote_en
        int reach "from engagement"
        text reach_unit "views, upvotes, likes, none"
        text competitor_fact_ref "DATA_RECORD id, if a competitor fact"
        jsonb extra
        text validation "valid, quarantined, deleted"
        text reject_reason
        vector embedding
    }
    CASE {
        text id PK "CASE-G60-0012"
        uuid feature_id FK
        text title "the problem"
        text state "observed, open, confirmed, rejected"
        text body_md "Notion-like page, markdown"
        int body_version
        jsonb figures "customers per market, opinions, reach, study, equipment, competitors"
        bool market_conflict
        text scope_tag
        text brand_fit
        text segment
        int manual_rank "PM override, null = by score"
        text manual_rank_reason
    }
    CASE_SCORE {
        uuid id PK
        text case_id FK
        uuid weight_profile_id FK
        jsonb factors "value per factor"
        float score
        timestamptz computed_at
    }
    REQUIREMENT {
        text id PK "REQ-G60-US-0012"
        text case_id FK
        text market "set only when split per market"
        text body_md "Notion-like page, markdown"
        int body_version
        text metric_target
        text acceptance_criteria
        text release_target "next_gen, current_car, ota"
        text evidence_level "bmw_data, web, assumption"
        text assumptions
        text cost_size "S, M, L"
        text cost_source "option_price, ai_estimate, pm, engineering"
        text status "draft, in_discussion, approved, rejected, exported, deleted"
        float rank_score "case score adjusted by cost"
        int manual_rank
    }
    DECISION {
        uuid id PK
        text object_type "case, requirement"
        text object_id
        text actor "PM user id"
        text action "open, confirm, reject, edit, reorder, approve, delete, export"
        text rationale
    }
    CHAT_MESSAGE {
        uuid id PK
        text object_type "case, requirement"
        text object_id
        text role "pm, agent"
        text content
        uuid_array cited_findings
        jsonb proposed_diff "accepted by PM or not"
    }
    AUDIT_EVENT {
        bigint seq PK
        timestamptz at
        text actor "agent name or PM id"
        text actor_type "ai, human"
        text action
        text object_type
        text object_id
        jsonb before
        jsonb after
        text rationale
    }

    CONFIG ||--o{ WEIGHT_PROFILE : has
    VEHICLE ||--o{ SALES_VOLUME : sells
    VEHICLE ||--o{ STUDY_SCORE : rated
    VEHICLE ||--o{ VEHICLE_FEATURE : offers
    FEATURE ||--o{ VEHICLE_FEATURE : "offered as"
    FEATURE ||--o{ STUDY_SCORE : measures
    SOURCE ||--o{ FINDING : yields
    DATA_RECORD ||--o{ FINDING : "backs competitor facts"
    AGENT_RUN ||--o{ FINDING : produced
    FEATURE ||--o{ CASE : groups
    CASE ||--o{ FINDING : contains
    CASE ||--o{ CASE_SCORE : "scored as"
    WEIGHT_PROFILE ||--o{ CASE_SCORE : weights
    CASE ||--|{ REQUIREMENT : "generates (1, or 1 per market)"
    CASE ||--o{ CHAT_MESSAGE : discussed
    REQUIREMENT ||--o{ CHAT_MESSAGE : discussed
    CASE ||--o{ DECISION : receives
    REQUIREMENT ||--o{ DECISION : receives
