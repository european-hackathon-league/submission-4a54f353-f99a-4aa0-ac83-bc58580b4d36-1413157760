# Copy to backend/.env and fill in. backend/.env is gitignored.

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
# Server key: the new secret key (sb_secret_...) or the legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: JWKS endpoint for token checks (default <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=
# Postgres connection string: Supabase dashboard -> Connect -> Session pooler
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# API auth: supabase (Bearer token) | dev (X-User-Id header). Empty = supabase if SUPABASE_URL is set.
AUTH_MODE=
# Legacy HS256 projects only; projects with signing keys are verified via JWKS.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5
# Prompts that use the strong model (others use OPENAI_CHAT_MODEL)
OPENAI_STRONG_TASKS=requirement_writer,case_tags
EMBEDDING_PROVIDER=openai          # openai | local (offline fallback)
EMBEDDING_MODEL=text-embedding-3-small

# Raw record storage: supabase | local
STORAGE_BACKEND=supabase

# Fetch loop (phase 8)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
FETCH_DAILY_REQUEST_BUDGET=500
