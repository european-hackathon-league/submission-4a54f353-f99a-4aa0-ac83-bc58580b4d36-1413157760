{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "enum": [
        "G60",
        "F70",
        "G70"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "shared",
        "overlay"
      ]
    },
    "region": {
      "type": "string",
      "enum": [
        "global",
        "RoW",
        "CN"
      ]
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "object",
      "properties": {
        "thesis": {
          "type": "string"
        },
        "targetCustomer": {
          "type": "object",
          "properties": {
            "who": {
              "type": "string",
              "enum": [
                "keep_owners",
                "conquest",
                "both"
              ]
            },
            "positioning": {
              "type": "string",
              "enum": [
                "base",
                "premium",
                "luxury"
              ]
            }
          },
          "required": [
            "who",
            "positioning"
          ],
          "additionalProperties": false
        },
        "marketWeights": {
          "type": "object",
          "properties": {
            "EU": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "US": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "CN": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "RoW": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "EU",
            "US",
            "CN",
            "RoW"
          ],
          "additionalProperties": false
        },
        "changeAmbition": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "evolution",
                "balanced",
                "revolution"
              ]
            },
            "innovationSlots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "level",
            "innovationSlots"
          ],
          "additionalProperties": false
        },
        "protectList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dontFightOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "givens": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string"
            },
            "sop": {
              "type": "string"
            },
            "frozen": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "openReleases": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "next_gen",
                  "lci",
                  "ota"
                ]
              }
            },
            "cycle": {
              "type": "string",
              "enum": [
                "WLTP",
                "EPA",
                "CLTC"
              ]
            }
          },
          "required": [
            "platform",
            "sop",
            "frozen",
            "openReleases",
            "cycle"
          ],
          "additionalProperties": false
        },
        "costEnvelope": {
          "type": "object",
          "properties": {
            "sensitivity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "perCarBand": {
              "type": "string"
            }
          },
          "required": [
            "sensitivity",
            "perCarBand"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "thesis",
          "targetCustomer",
          "marketWeights",
          "changeAmbition",
          "protectList",
          "dontFightOn",
          "givens",
          "costEnvelope"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "data",
              "brand",
              "doc",
              "pm"
            ]
          },
          "confirmed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "resolution": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "regional_variant",
                  "aligned"
                ]
              },
              "by": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "by",
              "at",
              "note"
            ],
            "additionalProperties": false
          },
          "updatedAt": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "confirmed",
          "updatedAt",
          "updatedBy"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "series",
    "kind",
    "region",
    "parentId",
    "ownerId",
    "values",
    "meta",
    "version",
    "createdAt",
    "updatedAt",
    "synthetic"
  ],
  "additionalProperties": false
}