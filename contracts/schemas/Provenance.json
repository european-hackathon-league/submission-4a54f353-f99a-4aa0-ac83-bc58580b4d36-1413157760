{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "evidence",
        "pm_context",
        "assumption"
      ]
    },
    "layer": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "brand",
            "series_brief",
            "case_stance",
            "requirement_shape",
            "feedback"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "signalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "path",
    "source",
    "layer",
    "ref",
    "signalIds",
    "label"
  ],
  "additionalProperties": false
}